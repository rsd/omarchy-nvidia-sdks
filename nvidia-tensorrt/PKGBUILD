# Maintainer: Raul Dias <raul@dias.com.br>
#
# A local Arch package of NVIDIA TensorRT, so that several projects on one
# machine (e.g. an ONNX Runtime build with the TensorRT execution provider)
# share one installation. For personal use: the archive is downloaded from
# NVIDIA by makepkg on your machine (NVIDIA serves it publicly, without a
# login, under its TensorRT Software License Agreement), or is one you
# supply. This repository holds only the recipe. The built package contains
# NVIDIA software: keep it on your own machine and never redistribute it (no
# repository, no AUR binary, no release, no sharing).
#
# The package is built from this working tree (the directory above), not
# from a git clone, so nothing has to be committed to build it.
#
# Where TensorRT comes from (decided once, at global scope, so that makepkg
# knows whether it has anything to download; first match wins):
#   1. NVIDIA_TRT_SRC in the environment (not empty)       -> manual
#   2. NVIDIA_TRT_SRC in selection.conf in this directory   -> manual
#      (written by configure.sh; parsed as KEY=value lines by selection.sh,
#      never sourced; a file with any line that is not blank, a comment or
#      a valid NVIDIA_TRT_SHA256= is manual too, and prepare() reports it)
#   3. the file ~/Downloads/<_trt_archive> exists           -> manual, that file
#   4. otherwise                                            -> download
# Manual: NVIDIA_TRT_SRC is an absolute path: the archive (_trt_archive
# below), a directory holding exactly one TensorRT-*.tar.* archive, or an
# extracted tree (a directory whose include/ holds NvInferVersion.h, or that
# holds one such directory). source.sh has the rules. No archive is in
# source=().
# Download: makepkg fetches _trt_url (about 3.7 GB) into SRCDEST (default:
# this directory) and checks it against _trt_sha256
# (SKIP when none is pinned). A file of that name already in this directory
# or in SRCDEST is reused, so SRCDEST=~/Downloads makepkg -f reuses an
# existing copy. Consequence: `makepkg --printsrcinfo` depends on the
# environment, selection.conf and ~/Downloads; a published .SRCINFO is the
# download case (none of the three set).
# Global scope prints nothing and changes nothing; prepare() prints which
# source is used and where it came from, and fails if it would decide
# differently from global scope.
# An archive, downloaded or not, is copied into $srcdir once, and only that
# copy is read: it is verified against _trt_sha256 (when one is pinned; else
# it must carry the name _trt_archive, and its SHA-256 is checked against the
# one configure.sh --write recorded, if any, and printed), its members are
# checked (not the ARM build; no device, fifo or socket, no symbolic link
# that is absolute or leads out of the tree) and it is extracted with bsdtar
# into $srcdir (never next to the download or into this repository). An
# extracted tree has no checksum and is copied. Either way the tree in
# $srcdir is checked again (the same refusals, the links resolved) and the
# version in include/NvInferVersion.h must be pkgver.
#
# Build (from nvidia-tensorrt/), e.g.:
#   makepkg -f                      # downloads, or uses ~/Downloads
#   SRCDEST=~/Downloads makepkg -f  # downloads there, or reuses a copy
#   ./configure.sh --src ~/Downloads --write && makepkg -f
#   NVIDIA_TRT_SRC=~/Downloads/TensorRT-Enterprise-11.4.0.106-Linux-x86_64-cuda-13.4-Release-external.tar.zst makepkg -f
# The package is several GiB; PKGEXT=.pkg.tar skips a slow compression:
#   PKGEXT=.pkg.tar makepkg -f
# Install the result with:  sudo pacman -U nvidia-tensorrt-sdk-local-*.pkg.tar*
#
# It installs the TensorRT tree as shipped under /opt/nvidia/tensorrt
# (include, lib, bin, python, samples, data, doc, and targets/ when the
# archive ships its files there), a pkg-config file,
# /opt/nvidia/tensorrt/lib/pkgconfig/nvidia-tensorrt.pc (in
# targets/x86_64-linux-gnu/lib/pkgconfig when the tree has no lib/), and an
# environment
# file, /usr/share/nvidia-tensorrt/nvidia-tensorrt.env, that a consumer
# loads explicitly. One file under /etc, /etc/ld.so.conf.d/nvidia-tensorrt-sdk.conf,
# puts the library directory on the system loader path (libnvinfer loads its
# builder-resource and plugin libraries by bare name, which a RUNPATH does not
# cover). Nothing under /usr/include; /usr/lib holds only symbolic links, one
# per library whose ELF SONAME starts with do_not_link_against_ (the
# builder-resource libraries, found at package time), each to the file in the
# library directory: libnvinfer dlopens those by file name, which the loader
# entry alone does not resolve. No profile.d script: trtexec is not on PATH
# and the Python wheels are shipped, not installed into site-packages.
#
# shellcheck source-path=SCRIPTDIR

pkgname=nvidia-tensorrt-sdk-local
pkgver=11.4.0.106
pkgrel=4
pkgdesc="NVIDIA TensorRT for CUDA 13.4, downloaded from NVIDIA at build time, packaged under /opt/nvidia/tensorrt (personal use, not redistributable)"
arch=('x86_64')
url='https://developer.nvidia.com/tensorrt/download'
license=('LicenseRef-NVIDIA-TensorRT')  # the TensorRT Software License Agreement
depends=(
  'cuda>=13.4'    # the CUDA 13 runtime libraries TensorRT 11 for CUDA 13.4 loads,
  'cuda<14'       # and cudart.pc, which nvidia-tensorrt.pc requires
  'nvidia-utils'  # libcuda.so.1 (the driver)
)
# Conflicts with the AUR's tensorrt: with the loader entry below, both copies
# are on the system library path, ldconfig's cache resolves each soname
# (libnvinfer.so.11, ...) to one copy by directory order, and libnvinfer then
# dlopens its siblings by exact versioned name from the cache, so with two
# different TensorRT 11 releases installed a process could mix libraries of
# two releases. provides and conflicts on the same name let pacman offer to
# replace one with the other cleanly. A package that depends on
# tensorrt=11.4.0.106 stays satisfied by provides, but must find TensorRT
# through the loader, the environment file or pkg-config, not under /usr. We
# install no Python module (the wheels are shipped, not installed), so
# python-tensorrt is not provided. The AUR's tensorrt owns real files in
# /usr/lib with the names of our builder-resource links; conflicts handles
# that too.
conflicts=('tensorrt')
provides=("nvidia-tensorrt-sdk=$pkgver" "tensorrt=$pkgver")
# Keep NVIDIA's files byte-identical.
options=('!strip' '!debug' 'staticlibs')
# The recipe's helpers (its scripts, the shim's source, the documents it
# installs): this repository's working tree, resolved at build time.
_repo=$(realpath -- "$startdir/..")

# The archive this recipe packages, its SHA-256 (as published in the Arch
# User Repository's tensorrt recipe) and where NVIDIA serves it (the same URL
# as that recipe's). configure.sh reads the _trt_archive and _trt_sha256
# lines: keep them as literal one-line assignments. The archive is the Linux
# x86_64 build: the ARM one (-Linux-aarch64- or -Linux-sbsa-) is refused.
# _trt_sha256 may be left empty for a future release whose checksum nobody
# publishes: the archive is then accepted by its name and contents, and its
# SHA-256 is printed for you to compare (and checked against the one
# configure.sh --write recorded). This release's is pinned.
_cudaver=13.4
_trt_archive=TensorRT-Enterprise-11.4.0.106-Linux-x86_64-cuda-13.4-Release-external.tar.zst
_trt_sha256=c67c87674cbe7b2337d1c30cb16d48686ab79ecb11bf08cb764b71f4f2bb711b
_trt_url=https://developer.nvidia.com/downloads/compute/machine-learning/tensorrt/${pkgver%.*}/tars/TensorRT-Enterprise-${pkgver}-Linux-${CARCH}-cuda-${_cudaver}-Release-external.tar.zst

# Manual or download (see the header). selection.conf is never sourced
# here. It leaves the download case only when it holds nothing but blank
# lines, comments and one NVIDIA_TRT_SHA256=<64 hex digits> line (which
# applies to no source of its own): any other line, valid or not, and a
# file that cannot be read, make it manual, so an invalid file is reported
# by prepare() (which parses it with selection.sh and stops on any line
# that is not valid) before anything is downloaded. The helpers are not
# read here: in a copy that fetches them (the AUR's), they do not exist
# yet. Silent: this runs under --printsrcinfo.
_trt_mode=download
_trt_conf=$startdir/selection.conf
if [[ -n ${NVIDIA_TRT_SRC:-} ]]; then
  _trt_mode=manual
elif [[ -e $_trt_conf || -L $_trt_conf ]]; then
  if [[ ! -f $_trt_conf || ! -r $_trt_conf ]]; then
    _trt_mode=manual
  else
    _trt_sha_lines=0
    while IFS= read -r _trt_line || [[ -n $_trt_line ]]; do
      [[ $_trt_line =~ ^[[:space:]]*(#|$) ]] && continue
      if [[ $_trt_line =~ ^NVIDIA_TRT_SHA256=[0-9a-f]{64}$ ]] && ((++_trt_sha_lines == 1)); then
        continue
      fi
      _trt_mode=manual
      break
    done <"$_trt_conf"
    unset _trt_line _trt_sha_lines
  fi
fi
if [[ $_trt_mode == download && -f $HOME/Downloads/$_trt_archive ]]; then
  _trt_mode=manual
fi
unset _trt_conf
if [[ $_trt_mode == download ]]; then
  source=("$_trt_archive::$_trt_url")
  sha256sums=("${_trt_sha256:-SKIP}")
  noextract=("$_trt_archive")
else
  source=()
fi

_root=/opt/nvidia/tensorrt

prepare() {
  # The source, by the precedence in the header. The helpers only define
  # functions; selection.conf is parsed, never sourced.
  # shellcheck source=selection.sh
  . "$_repo/nvidia-tensorrt/selection.sh"
  # shellcheck source=source.sh
  . "$_repo/nvidia-tensorrt/source.sh"
  # What source.sh's refusal of the ARM build names.
  local trt_expected_archive=$_trt_archive trt_expected_version=$pkgver trt_download_url=$url
  if [[ ${_trt_url##*/} != "$_trt_archive" ]]; then
    echo "the download URL names ${_trt_url##*/}, not _trt_archive ($_trt_archive)" >&2
    return 1
  fi
  nvidia_trt_resolve "$startdir/selection.conf" "$HOME/Downloads/$_trt_archive" || return 1
  # The decision global scope made, taken again: they must agree.
  local mode=download
  if [[ $nvidia_trt_src_from != default || -f $nvidia_trt_src ]]; then mode=manual; fi
  if [[ $mode != "$_trt_mode" ]]; then
    echo "the source changed while makepkg ran: global scope chose $_trt_mode, prepare() finds" \
      "$mode (NVIDIA_TRT_SRC, selection.conf or ~/Downloads/$_trt_archive); run makepkg again" >&2
    return 1
  fi
  echo "TensorRT source:"
  if [[ $_trt_mode == download ]]; then
    # makepkg's symlink to the file it downloaded (or found in SRCDEST).
    nvidia_trt_sha256=''
    nvidia_trt_src=$(realpath -- "$srcdir/$_trt_archive") || return 1
    echo "  $_trt_archive (from download: fetched by makepkg from $_trt_url," \
      "or reused from a copy of that name in the recipe directory or SRCDEST)"
  else
    nvidia_trt_print_resolved
  fi
  trt_locate "$nvidia_trt_src" || return 1
  echo "  layout $trt_layout: $trt_path"
  local arm
  for arm in "${trt_arm_skipped[@]}"; do
    echo "  skipped $arm (the ARM (aarch64) build)"
  done
  rm -rf -- "$srcdir/tensorrt" "$srcdir/extract" "$srcdir/archive"

  if [[ $trt_layout == archive ]]; then
    # One private copy is hashed, checked and extracted: a download replaced
    # between those steps cannot pass the checksum and be extracted instead.
    local sum name=${trt_path##*/} copy
    mkdir -- "$srcdir/archive"
    copy=$srcdir/archive/$name
    cp --reflink=auto -- "$trt_path" "$copy" || return 1
    sum=$(trt_sha256 "$copy") || return 1
    if [[ -z $_trt_sha256 ]]; then
      # Not pinned: the name must be the recipe's. A download is named by its
      # source entry, not by what a SRCDEST symlink resolves to.
      if [[ $_trt_mode != download && $name != "$_trt_archive" ]]; then
        echo "$trt_path is not the archive this recipe packages: expected $_trt_archive," \
          "got $name (SHA-256 $sum)" >&2
        return 1
      fi
    elif [[ $sum != "$_trt_sha256" ]]; then
      # The ARM build is named as such, not as a damaged download.
      trt_refuse_arm_archive "$copy" "$trt_path" || return 1
      if [[ $_trt_mode == download ]]; then
        # Named by the source entry whatever it resolves to; makepkg's own
        # check catches this first, so this is reached with --skipchecksums.
        echo "$trt_path: SHA-256 mismatch: expected $_trt_sha256, got $sum." \
          "The download is incomplete or damaged: delete the copy of $_trt_archive in" \
          "the recipe directory or SRCDEST (and $trt_path, if it is another file)" \
          "so that makepkg downloads it again" >&2
      elif [[ $name == "$_trt_archive" ]]; then
        echo "$trt_path: SHA-256 mismatch: expected $_trt_sha256, got $sum." \
          "The file is incomplete or damaged: download it again from $url" >&2
      else
        echo "$trt_path is not the archive this recipe packages: expected $_trt_archive" \
          "(SHA-256 $_trt_sha256), got $name (SHA-256 $sum)" >&2
      fi
      return 1
    fi
    if [[ -n $nvidia_trt_sha256 && $nvidia_trt_sha256 != "$sum" ]]; then
      echo "$trt_path changed since configure.sh --write recorded SHA-256 $nvidia_trt_sha256" \
        "(now $sum): run $(printf %q "$(realpath -- "$_repo/nvidia-tensorrt/configure.sh")")" \
        "--conf $(printf %q "$startdir/selection.conf") --src $(printf %q "$trt_path") --write again" >&2
      return 1
    fi
    if [[ -n $_trt_sha256 ]]; then
      echo "  SHA-256 $sum verified"
    elif [[ -n $nvidia_trt_sha256 ]]; then
      echo "  SHA-256 $sum as configure.sh --write recorded it (not pinned: NVIDIA publishes no" \
        "checksum for this release; compare it with your download)"
    else
      echo "  SHA-256 $sum (not pinned: NVIDIA publishes no checksum for this release;" \
        "compare it with your download)"
    fi
    trt_check_archive "$copy" "" "$trt_path" || return 1
    # bsdtar refuses absolute paths and .. in the archive.
    mkdir -- "$srcdir/extract"
    bsdtar -xf "$copy" -C "$srcdir/extract" || return 1
    rm -rf -- "$srcdir/archive"
    trt_locate "$srcdir/extract" || return 1
    [[ $trt_layout == tree ]] || { echo "the archive holds an archive, not a TensorRT tree" >&2; return 1; }
    mv -- "$trt_path" "$srcdir/tensorrt"
    rm -rf -- "$srcdir/extract"
  else
    echo "  an extracted tree: no checksum to verify"
    # The ARM build is refused here, named as the source; the copy is
    # scanned again below.
    trt_scan tree "$trt_path" || return 1
    cp -a --reflink=auto -- "$trt_path" "$srcdir/tensorrt"
  fi
  # What is packaged: the copy in $srcdir, whatever the source was checked
  # as by configure.sh.
  trt_check_tree "$srcdir/tensorrt" || return 1

  trt_scan tree "$srcdir/tensorrt" || return 1
  if [[ $trt_version != "$pkgver" ]]; then
    echo "the source holds TensorRT ${trt_version:-(no version in include/NvInferVersion.h)}," \
      "but this recipe packages TensorRT $pkgver: download $_trt_archive from $url" >&2
    return 1
  fi
  if ((${#trt_missing[@]} > 0)); then
    echo "the source is incomplete; missing: ${trt_missing[*]}" >&2
    return 1
  fi
  echo "  TensorRT $trt_version: ${trt_features[*]}"
}

package() {
  # The tree as shipped (reflinks where the filesystem allows). fakeroot
  # makes it root-owned; directories 755, files at least 644.
  install -d "$pkgdir/opt/nvidia"
  cp -a --reflink=auto -- "$srcdir/tensorrt" "$pkgdir$_root"
  chmod -R u+rwX,go+rX,go-w -- "$pkgdir$_root"

  # The library directory: lib/ (a directory, or a link to
  # targets/x86_64-linux-gnu/lib), else targets/x86_64-linux-gnu/lib.
  local libdir=$_root/lib librel=lib
  if [[ ! -d $srcdir/tensorrt/lib && -d $srcdir/tensorrt/targets/x86_64-linux-gnu/lib ]]; then
    libdir=$_root/targets/x86_64-linux-gnu/lib librel=targets/x86_64-linux-gnu/lib
  fi

  # pkg-config: `pkg-config --cflags --libs nvidia-tensorrt` with
  # PKG_CONFIG_PATH=/opt/nvidia/tensorrt/lib/pkgconfig. The RPATH lets a
  # consumer find the libraries without LD_LIBRARY_PATH. TensorRT's headers
  # include the CUDA runtime's: Requires: cudart adds Arch cuda's
  # (/usr/lib/pkgconfig/cudart.pc, /opt/cuda/include).
  local pc="$pkgdir$libdir/pkgconfig/nvidia-tensorrt.pc"
  install -d "${pc%/*}"
  cat >"$pc" <<EOF
# NVIDIA TensorRT ($pkgname $pkgver-$pkgrel).
prefix=$_root
includedir=\${prefix}/include
libdir=\${prefix}/$librel

Name: nvidia-tensorrt
Description: NVIDIA TensorRT (personal-use package)
Version: $pkgver
Requires: cudart
Cflags: -I\${includedir}
Libs: -L\${libdir} -Wl,-rpath,\${libdir} -lnvinfer -lnvinfer_plugin -lnvonnxparser
EOF
  chmod 644 "$pc"

  # The system loader entry. libnvinfer dlopens its builder-resource and plugin
  # libraries by bare name, which the RUNPATH of the program that loads it does
  # not cover, so without this entry such a program needs LD_LIBRARY_PATH. It
  # resolves the normal sonames; the builder-resource libraries need the links
  # below. No install script: glibc's pacman hook (11-glibc-ldconfig.hook) runs
  # ldconfig after any install, upgrade or removal of a path under
  # etc/ld.so.conf.d/.
  local ldconf="$pkgdir/etc/ld.so.conf.d/nvidia-tensorrt-sdk.conf"
  install -d "${ldconf%/*}"
  cat >"$ldconf" <<EOF
# $pkgname: libnvinfer loads its builder-resource and plugin libraries by bare name
$libdir
EOF
  chmod 644 "$ldconf"
  if [[ $(grep -v '^#' "$ldconf") != "$libdir" ]]; then
    echo 'nvidia-tensorrt-sdk.conf: the generated file is not as expected' >&2
    return 1
  fi

  # Links in /usr/lib for the libraries with a hidden soname. NVIDIA gives the
  # builder-resource libraries (libnvinfer_builder_resource_sm120.so.11.4.0,
  # the _win_ variants, ...) the SONAME do_not_link_against_..., so ldconfig
  # caches them only under that name. libnvinfer has no RUNPATH and dlopens
  # them by FILE name, which glibc finds only through LD_LIBRARY_PATH, the
  # caller's RUNPATH or the default directories (/usr/lib): the loader entry
  # does not help, and ONNX Runtime's TensorRT provider fails with "Unable to
  # load library". So every regular file in the library directory whose SONAME
  # starts with do_not_link_against_ (found here, not listed) gets a link
  # /usr/lib/<file> -> <libdir>/<file>; the target does not exist at build
  # time, like the licence links'. NVIDIA's files are not modified. A file that
  # is not ELF is skipped.
  local hlib hname hsoname hcount=0
  while IFS= read -r -d '' hlib; do
    hname=${hlib##*/}
    hsoname=$(LC_ALL=C readelf -d -- "$hlib" 2>/dev/null | sed -n 's/.*Library soname: \[\(.*\)\].*/\1/p' | head -n 1) || true
    [[ $hsoname == do_not_link_against_* ]] || continue
    if [[ -e $pkgdir/usr/lib/$hname || -L $pkgdir/usr/lib/$hname ]]; then
      echo "/usr/lib/$hname already exists in the package" >&2
      return 1
    fi
    install -d "$pkgdir/usr/lib"
    ln -s "$libdir/$hname" "$pkgdir/usr/lib/$hname"
    echo "linked /usr/lib/$hname -> $libdir/$hname"
    hcount=$((hcount + 1))
  done < <(find "$pkgdir$libdir/" -maxdepth 1 -type f -print0 | sort -z)
  echo "$hcount library link(s) with a hidden soname in /usr/lib"

  # The environment file: KEY=value lines, no quotes, no expansion, so it
  # works as a systemd EnvironmentFile= and with `set -a; . file; set +a`.
  local envfile="$pkgdir/usr/share/nvidia-tensorrt/nvidia-tensorrt.env"
  install -d "${envfile%/*}"
  cat >"$envfile" <<EOF
# NVIDIA TensorRT ($pkgname $pkgver-$pkgrel).
# Usage: /usr/share/doc/$pkgname/README.md
# The package's /etc/ld.so.conf.d entry already makes the libraries visible to
# every program, so LD_LIBRARY_PATH from this file is no longer needed to run
# a program. The file stays for TENSORRT_HOME, the pkg-config directory, the
# root and include paths, and for programs that build their LD_LIBRARY_PATH
# from the *_LIBRARY_PATH keys.
# Load it for one program or one build only (systemd EnvironmentFile=, or
#   set -a; . /usr/share/nvidia-tensorrt/nvidia-tensorrt.env; set +a
# in a script); never from a login profile. A program you build is better
# linked with an RPATH to $_root/lib (pkg-config nvidia-tensorrt
# adds it) than run with LD_LIBRARY_PATH. A program that loads several
# such files gets the last file's LD_LIBRARY_PATH: it builds
# LD_LIBRARY_PATH itself from the NVIDIA_*_LIBRARY_PATH and
# MAXINE_*_LIBRARY_PATH keys. TENSORRT_HOME is the root, as ONNX Runtime's
# build (--tensorrt_home) and other CMake projects expect.
# NVIDIA_TRT_PKG_CONFIG_PATH is the directory to add to PKG_CONFIG_PATH.
NVIDIA_TRT_ROOT=$_root
NVIDIA_TRT_INCLUDE_DIR=$_root/include
NVIDIA_TRT_LIBRARY_PATH=$libdir
LD_LIBRARY_PATH=$libdir
NVIDIA_TRT_PKG_CONFIG_PATH=$libdir/pkgconfig
TENSORRT_HOME=$_root
NVIDIA_TRT_VERSION=$pkgver
EOF
  chmod 644 "$envfile"
  # Every key as specified, and no quote, $, space or other non-KEY=value
  # line outside the comments; every directory it names is in the package.
  if ! { grep -qx "NVIDIA_TRT_ROOT=$_root" "$envfile" &&
    grep -qx "NVIDIA_TRT_INCLUDE_DIR=$_root/include" "$envfile" &&
    grep -qx "NVIDIA_TRT_LIBRARY_PATH=$libdir" "$envfile" &&
    grep -qx "LD_LIBRARY_PATH=$libdir" "$envfile" &&
    grep -qx "NVIDIA_TRT_PKG_CONFIG_PATH=$libdir/pkgconfig" "$envfile" &&
    grep -qx "TENSORRT_HOME=$_root" "$envfile" &&
    grep -qx "NVIDIA_TRT_VERSION=$pkgver" "$envfile" &&
    ! grep -v '^#' "$envfile" | grep -q -e '["'\''$ ]' -e '^LD_PRELOAD=' -e '^[^=]*$'; }; then
    echo 'nvidia-tensorrt.env: the generated file is not as expected' >&2
    return 1
  fi
  local dir
  for dir in "$_root/include" "$libdir" "$libdir/pkgconfig"; do
    [[ -d $pkgdir$dir ]] || { echo "nvidia-tensorrt.env: $dir is not in the package" >&2; return 1; }
  done

  # Licences: links to TensorRT's own licence and notice files (those
  # present, at the top of the tree or in doc/). The links point into
  # $_root, which does not exist at build time.
  local licdir="$pkgdir/usr/share/licenses/$pkgname" lic rel
  install -d "$licdir"
  while IFS= read -r -d '' lic; do
    rel=${lic#"$srcdir/tensorrt/"}
    [[ ! -e $licdir/${lic##*/} && ! -L $licdir/${lic##*/} ]] || continue
    ln -s "$_root/$rel" "$licdir/${lic##*/}"
  done < <(find "$srcdir/tensorrt" -maxdepth 1 -type f \( -iname '*licen[cs]e*' -o -iname '*sla*' \
    -o -iname '*acknowledg*' -o -iname '*notice*' \) -print0 | sort -z
    [[ ! -d $srcdir/tensorrt/doc ]] || find "$srcdir/tensorrt/doc" -maxdepth 2 -type f \
      \( -iname '*licen[cs]e*' -o -iname '*sla*' -o -iname '*acknowledg*' -o -iname '*notice*' \) -print0 | sort -z)

  # A pointer to the licence terms, in our own words.
  cat >"$licdir/TERMS.txt" <<EOF
NVIDIA TensorRT ($pkgname $pkgver-$pkgrel)

TensorRT is under NVIDIA's TensorRT Software License Agreement:
https://docs.nvidia.com/deeplearning/tensorrt/latest/reference/sla.html

The archive was downloaded from NVIDIA by the makepkg of the user who built
this package (NVIDIA serves it to that user under that licence; the recipe
does not redistribute it), or was supplied by that user.

This built package must not be redistributed. Only the runtime .so files may
be redistributed, and only inside an application that adds material
functionality (TensorRT SLA supplement, sections 2 and 1.2).
EOF
  chmod 644 "$licdir/TERMS.txt"

  install -Dm644 "$_repo/nvidia-tensorrt/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
