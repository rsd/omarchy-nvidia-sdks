#!/bin/sh
# The licence guard on every commit: refuses staged NVIDIA or binary files
# (scripts/check-no-nvidia.sh). Enabled per clone with
#   git config core.hooksPath .githooks
set -eu
# The guard next to this hook (the repository that holds it); git runs a
# hook from the top of the work tree being committed or pushed.
guard=$(cd "$(dirname "$0")/.." && pwd)/scripts/check-no-nvidia.sh
exec "$guard" --staged
